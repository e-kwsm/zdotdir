#compdef keychain

# keychain 3.0.0

_keychain() {
  typeset curcontext=$curcontext state lstate line
  local -ar args=(
    '(- *)'{-h,--help}'[Print the top-level help cheat sheet, or action-specific help when followed by an action path]'
    '(- *)'{-V,--version}'[Print the version banner and exit]'
    '--explain[This global instructs keychain to not actually act upon the the command-line but instead evaluate the command-line arguments (minus the --explain option) and print documentation boxes for the action, every recognised option and positional argument to standard output]'
    '(--quiet -q)'{--quiet,-q}'[Silence informational messages on stderr]'
    ''{--debug,-D}'[Emit extra details about agent-discovery decision keychain makes: which pidfile candidates were considered, which sockets were probed, why one was selected, what ssh -G returned for each host: extkey, etc]'
    '*::keychain command:_keychain_command'
  )
  _arguments "${(@)args}"
}

# _keychain-command {{{1
(( $+functions[_keychain_command] )) || _keychain_command() {
  local -ar _keychain_cmds=(
    'add:Add keys to the agent (auto-start one if needed)'
    'agent:Agent lifecycle (start | stop)'
    'env:Print agent env in the requested format'
    'forget:Evict specific SSH keys from ssh-agent'
    'help:Print the cheat-sheet (same as --help)'
    'inspect:Structured snapshot of every state probe'
    'list:List keys currently held by ssh-agent'
    'man:Full documentation'
    'version:Print version banner'
    'wipe:Wipe loaded keys (default: both ssh and gpg)'
  )

  if (( CURRENT == 1 )); then
    _describe -t commands 'keychain command' _keychain_cmds
  else
    typeset curcontext="$curcontext" ret=1

    cmd="${${_keychain_cmds[(r)$words[1]:*]%%:*}}"

    if (( $#cmd )); then
      curcontext="${curcontext%:*:*}:keychain-${cmd}:"

      if [ $cmd = 'help' ]; then
        _message 'no more arguments'
      elif ! _call_function ret _keychain-$cmd; then
	_default && ret=0
      fi
    else
      _default && ret=0
    fi
    return ret
  fi
}

(( $+functions[_keychain-add] )) || _keychain-add() {
  local -ar args=(
    '(- *)--help[show help]'
    '*:keys:_files -g "id_*"'
  )
  _arguments "${(@)args}"
}

(( $+functions[_keychain-env] )) || _keychain-env() { :; }

return

